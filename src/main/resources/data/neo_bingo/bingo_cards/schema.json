{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qiye-yuri/bingo-neoforge/blob/main/src/main/resources/data/neo_bingo/bingo_cards/schema.json",
  "title": "Neo Bingo card definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "size", "objectives"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
      }
    }
  }
}
